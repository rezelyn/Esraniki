# ╭───────────────────────────╮
# │ APPLICATION CONFIGURATION │
# ╰───────────────────────────╯
TOKEN=<your_app_token> # The app token, used to authenticate with the Discord API
CLIENT_ID=<your_app_id> # The client ID of your Discord application, used for the dashboard authentication
CLIENT_SECRET=<your_app_secret> # The client secret key of your Discord application, used for the dashboard authentication
REDIRECT_URI=http://0.0.0.0:3000/auth/callback # The redirect URI, should match the one set in your Discord application settings
#                                              ╰ Replace the host with your server's IP or domain if not running locally
DASHBOARD_PORT=3000 # The redirect URI port, should match the port in the 'REDIRECT_URI', you do not need change this unless

# ╭───────────────────────────╮
# │ DEVELOPMENT CONFIGURATION │
# ╰───────────────────────────╯
GUILD_ID=<dev_guild_id> # The guild ID to use for development, if a guild ID is set, commands will be cleared and will only be registered in that guild  which allows for faster testing
#                       ╰ If not set, commands will be registered globally, which can take up to an hour to update, will be ignored if running in production mode
OWNER_ID=<owner_user_id> # The owner ID, used to restrict access to certain commands or dashboard features to the app owner only, currently not supported by the application

# ╭────────────────────╮
# │ TWITCH INTEGRATION │ https://dev.twitch.tv/console/apps - Create an application to get these credentials, the redirect URI can be the same as the one used for Discord
# ╰────────────────────╯
TWITCH_CLIENT_ID=<your_twitch_client_id> # The client ID of your Twitch application, used for Twitch integration features
TWITCH_CLIENT_SECRET=<your_twitch_client_secret> # The client secret of your Twitch application, used for Twitch integration features

# ╭─────────────────────────────────────────────╮
# │ YTDL INTEGRATION (WIP, NOT IMPLEMENTED YET) │
# ╰─────────────────────────────────────────────╯
COOKIES_FILE=<path_to_cookies_file> # Path to a Netscape-format cookies.txt file
#                                   │ Helps avoid YouTube "HTTP Error 403: Forbidden" errors
#                                   │ If a cookies.txt file exists in the project root, it is used automatically
#                                   ╰ Only set these to override that default
COOKIES_FROM_BROWSER=<browser_name>[+<keyring>][:<profile_name>][::<container_name>] # Read cookies directly from an installed browser instead
#                                                                                    ╰ Overrides COOKIES_FILE if both are set
YTDL_PLAYER_CLIENTS=android_vr,web_embedded,mweb # Comma-separated yt-dlp player clients to try, in order
#                                                │ YouTube restricts playable formats for some clients, especially when using cookies
#                                                ╰ If you get "Requested format is not available" errors, set this to force clients that don't require login
