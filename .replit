modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
DASHBOARD_PORT = "3000"
REDIRECT_URI = "https://b63c33ec-b165-4254-9600-9c680882e081-00-1c51r09sc07u0.janeway.replit.dev/auth/callback"

[workflows]

[[workflows.workflow]]
name = "Build"
mode = "sequential"
author = 14032024

[[workflows.workflow.tasks]]
task = "packager.installForAll"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow]]
name = "Run"
mode = "parallel"
author = 14032024

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"

[[ports]]
localPort = 3000
externalPort = 80
